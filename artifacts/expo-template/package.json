{
  "name": "@workspace/expo-template",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build:web": "expo export -p web --output-dir dist",
    "build:preview": "eas build --profile preview",
    "build:production": "( [ \"$(git rev-parse --abbrev-ref HEAD)\" = main ] && git diff-index --quiet HEAD && git fetch origin main && [ \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/main)\" ] || ( echo 'Refusing to build: must be on main, clean, and up to date with origin/main' >&2 ; exit 1 ) ) && eas build --platform ios --profile production --auto-submit",
    "update:production": "( [ \"$(git rev-parse --abbrev-ref HEAD)\" = main ] && git diff-index --quiet HEAD && git fetch origin main && [ \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/main)\" ] || ( echo 'Refusing to publish update: must be on main, clean, and up to date with origin/main' >&2 ; exit 1 ) ) && eas update --branch production",
    "update": "eas update",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "optimize:images": "node scripts/optimize-images.mjs",
    "eas-build-pre-install": "corepack enable && corepack prepare pnpm@10.33.0 --activate"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/cli": "54.0.23",
    "@expo/config-plugins": "~54.0.0",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@ungap/structured-clone": "^1.3.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.27",
    "expo-audio": "~1.0.14",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.11",
    "expo-font": "~14.0.10",
    "expo-glass-effect": "~0.1.4",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-localization": "~17.0.7",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.8",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "expo-web-browser": "~15.0.10",
    "lottie-react-native": "7.3.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.81.5",
    "react-native-appsflyer": "^6.15.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^15.7.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-purchases": "^9.0.0",
    "react-native-purchases-ui": "^9.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2",
    "zod": "catalog:",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.2.0",
    "expo-game-center": "file:./modules/expo-game-center",
    "expo-icloud-kv": "file:./modules/expo-icloud-kv",
    "expo-play-games-services": "file:./modules/expo-play-games-services",
    "expo-updates": "~29.0.16",
    "planck": "^1.5.0"
  }
}
